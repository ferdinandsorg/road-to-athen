VITE_USE_FIXTURES=false
VITE_MAPBOX_ACCESS_TOKEN=

# SFTP deploy (npm run deploy) — copy to .env.local, never commit secrets
# IONOS/1&1: plain FTP is disabled → we use SFTP on port 22
FTP_HOST=homeXXXXXXXX.1and1-data.host
FTP_USER=
FTP_PASSWORD=
# IONOS: SFTP landets oft schon IN public_html → dann "/" nutzen.
# Nur "/public_html" wenn die Session im Account-Root startet.
FTP_REMOTE_DIR=/
FTP_PORT=22
# Empty remote dir before upload (destructive — use with care)
# FTP_CLEAN=true
